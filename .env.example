# Copy to .env.local and fill in. Nothing here is committed with real values.

# Public site URL (the final domain has not been chosen yet).
NEXT_PUBLIC_SITE_URL=https://jamiejames.com

# Approved public contact address. Shown in the footer and as the alternate
# contact when an inquiry cannot be delivered. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Jamie's social profiles. Each icon appears in the navbar only when its URL is
# set, so the site never links to a profile that doesn't exist.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Inquiry delivery (required in production) ─────────────────────────────
# The approved booking inbox that receives inquiries.
INQUIRY_TO_EMAIL=
# Any SMTP provider works. Confirm hosting and email costs before choosing one.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); defaults to true only on 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender address for the notification and the acknowledgment email.
# Defaults to SMTP_USER, then INQUIRY_TO_EMAIL.
INQUIRY_FROM_EMAIL=

# If INQUIRY_TO_EMAIL / SMTP_HOST are missing in production, /api/inquiry
# returns an honest 503 and the form shows an error. It never pretends to send.
# In local development (NODE_ENV != production) it logs the inquiry instead.
